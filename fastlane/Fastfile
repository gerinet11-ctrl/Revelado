# Firma Moon con un certificado de distribución y la sube a TestFlight desde un Mac de GitHub.
# Usa la clave de App Store Connect guardada en los secretos del repositorio. Se lanza desde
# .github/workflows/ios.yml; no hace falta ejecutarlo a mano.
require "openssl"
require "base64"

default_platform(:ios)

APP_ID = "com.gerinet11.moon"
PROJECT = "ios/App/App.xcodeproj"

# Clave privada del certificado de distribución. Se calcula siempre igual a partir de la clave de App Store
# Connect (que está en los secretos), así todas las compilaciones usan el mismo certificado en vez de crear
# uno nuevo cada vez. No se guarda en ningún sitio.
def moon_signing_key(secret)
  ctr = 0
  stream = lambda do |bytes|
    out = "".b
    while out.bytesize < bytes
      out << OpenSSL::HMAC.digest("SHA256", secret, "moon-dist-cert-v1:#{ctr}")
      ctr += 1
    end
    out[0, bytes]
  end
  e = OpenSSL::BN.new(65537)
  prime = lambda do
    loop do
      raw = stream.call(128).bytes
      raw[0] |= 0xC0
      raw[-1] |= 1
      c = OpenSSL::BN.new(raw.pack("C*"), 2)
      next unless c.prime?
      next if ((c - 1) % e).zero?
      return c
    end
  end
  p = prime.call
  q = prime.call
  p, q = q, p if p < q
  n = p * q
  d = e.mod_inverse((p - 1) * (q - 1))
  parts = [OpenSSL::BN.new(0), n, e, d, p, q, d % (p - 1), d % (q - 1), q.mod_inverse(p)]
  OpenSSL::PKey::RSA.new(OpenSSL::ASN1::Sequence(parts.map { |v| OpenSSL::ASN1::Integer(v) }).to_der)
end

platform :ios do
  desc "Firma Moon y la sube a TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], key_filepath: ENV["ASC_KEY_PATH"], in_house: false
    )
    setup_ci
    keychain = File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db")

    # Certificado de distribución: se busca el de Moon en la cuenta y, si no está, se crea una sola vez.
    # No se borra ni se retira nada.
    key = moon_signing_key(File.read(ENV["ASC_KEY_PATH"]).gsub(/-----[^-]+-----|\s/, ""))
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], filepath: ENV["ASC_KEY_PATH"]
    )
    certs = Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: "DISTRIBUTION" })
    UI.message("Certificados de distribución en la cuenta: #{certs.length}")
    mine = certs.find do |c|
      begin
        OpenSSL::X509::Certificate.new(Base64.decode64(c.certificate_content)).public_key.n == key.n
      rescue StandardError
        false
      end
    end
    if mine
      UI.success("Se reutiliza el certificado de distribución de Moon (#{mine.id})")
    else
      UI.message("Creando el certificado de distribución de Moon…")
      csr = OpenSSL::X509::Request.new
      csr.version = 0
      csr.subject = OpenSSL::X509::Name.new([["CN", "Moon Distribution", OpenSSL::ASN1::UTF8STRING]])
      csr.public_key = key
      csr.sign(key, OpenSSL::Digest.new("SHA256"))
      begin
        mine = Spaceship::ConnectAPI::Certificate.create(certificate_type: "DISTRIBUTION", csr_content: csr.to_pem)
      rescue StandardError => ex
        UI.user_error!("Apple no dejó crear el certificado (#{ex.message.to_s[0, 300]}). Si es por el límite de certificados, hay que retirar uno antiguo en developer.apple.com → Certificates.")
      end
      UI.success("Certificado de distribución de Moon creado (#{mine.id})")
    end
    tmp = ENV["RUNNER_TEMP"] || Dir.tmpdir
    key_path = File.join(tmp, "moon_dist.key")
    cer_path = File.join(tmp, "moon_dist.cer")
    File.write(key_path, key.to_pem)
    File.binwrite(cer_path, Base64.decode64(mine.certificate_content))
    begin
      sh("security", "import", key_path, "-k", keychain, "-T", "/usr/bin/codesign", "-T", "/usr/bin/security", log: false)
      sh("security", "import", cer_path, "-k", keychain, "-T", "/usr/bin/codesign", "-T", "/usr/bin/security", log: false)
      sh("security", "set-key-partition-list", "-S", "apple-tool:,apple:,codesign:", "-s", "-k", "", keychain, log: false)
    ensure
      File.delete(key_path) if File.exist?(key_path)
    end
    begin
      FastlaneCore::CertChecker.install_missing_wwdr_certificates(keychain)
    rescue StandardError => ex
      UI.important("No se pudieron instalar los certificados intermedios de Apple: #{ex.message}")
    end
    sh("security find-identity -v -p codesigning #{keychain.shellescape} | tail -3")

    sigh(api_key: api_key, app_identifier: APP_ID, cert_id: mine.id)
    perfil = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      use_automatic_signing: false, path: PROJECT, team_id: ENV["APPLE_TEAM_ID"], targets: ["App"],
      build_configurations: ["Release"], code_sign_identity: "Apple Distribution",
      profile_name: perfil, bundle_identifier: APP_ID
    )
    build_app(
      project: PROJECT, scheme: "App", configuration: "Release", clean: true,
      export_method: "app-store", output_directory: ENV["RUNNER_TEMP"], output_name: "Moon.ipa",
      xcargs: "CURRENT_PROJECT_VERSION=#{ENV['BUILD_NUMBER']}",
      export_options: { provisioningProfiles: { APP_ID => perfil } }
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
  desc "Crea el grupo externo de TestFlight con enlace público, añade la última compilación y la envía a revisión"
  lane :invitar do
    nombre = ENV["GRUPO"] || "Testers Moon"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], filepath: ENV["ASC_KEY_PATH"]
    )
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("No se encontró la app #{APP_ID} en App Store Connect") unless app

    # Última compilación ya procesada por Apple
    builds = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 15)
    builds.each { |b| UI.message("Compilación #{b.version} · estado #{b.processing_state} · #{b.uploaded_date}") }
    build = builds.find { |b| b.processing_state == "VALID" }
    UI.user_error!("Todavía no hay una compilación procesada por Apple. Espera unos minutos y vuelve a lanzar.") unless build
    UI.success("Se usa la compilación #{build.version}")

    # Grupo externo con enlace público
    grupo = app.get_beta_groups.find { |g| g.name == nombre }
    if grupo
      UI.message("El grupo «#{nombre}» ya existe")
    else
      grupo = app.create_beta_group(group_name: nombre, public_link_enabled: true, public_link_limit_enabled: false)
      UI.success("Grupo «#{nombre}» creado")
    end
    begin
      build.add_beta_groups(beta_groups: [grupo])
    rescue StandardError => ex
      UI.important("Al añadir la compilación al grupo: #{ex.message.to_s[0, 400]}")
    end
    UI.success("Compilación #{build.version} añadida al grupo")

    # Revisión de Apple para pruebas externas
    begin
      build.post_beta_app_review_submission
      UI.success("Enviada a revisión de Apple")
    rescue StandardError => ex
      UI.important("No se pudo enviar a revisión: #{ex.message.to_s[0, 700]}")
    end

    grupo = app.get_beta_groups.find { |g| g.id == grupo.id } || grupo
    UI.success("ENLACE PÚBLICO: #{grupo.public_link.inspect} · activo: #{grupo.public_link_enabled.inspect}")
  end
  desc "Muestra los grupos de TestFlight y el estado de revisión de cada compilación (sin mostrar correos)"
  lane :estado do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], filepath: ENV["ASC_KEY_PATH"]
    )
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("No se encontró la app") unless app
    Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 15).each do |b|
      det = begin
        r = Spaceship::ConnectAPI.get_build_beta_details(filter: { build: b.id })
        (r.body["data"] || []).map { |d| "externo=#{d["attributes"]["externalBuildState"]} · interno=#{d["attributes"]["internalBuildState"]}" }.join(" ")
      rescue StandardError => ex
        "no se pudo leer (#{ex.message.to_s[0, 100]})"
      end
      rev = begin
        r = Spaceship::ConnectAPI.get_beta_app_review_submissions(filter: { build: b.id })
        d = (r.body["data"] || []).map { |x| x["attributes"]["betaReviewState"] }.join(",")
        d.empty? ? "sin enviar" : d
      rescue StandardError => ex
        "no se pudo leer (#{ex.message.to_s[0, 100]})"
      end
      UI.message("BUILD #{b.version}: revisión=#{rev} · #{det}")
    end
    app.get_beta_groups.each do |g|
      n = begin; g.fetch_beta_testers.length; rescue StandardError; "?"; end
      bs = begin; g.fetch_builds.map(&:version).join(", "); rescue StandardError; "?"; end
      UI.message("GRUPO «#{g.name}»: interno=#{g.is_internal_group.inspect} · enlace público=#{g.public_link_enabled.inspect} · testers=#{n} · compilaciones=[#{bs}]")
    end
  end
  desc "Retira la compilación en revisión y envía otra (OLD y NEW son los números de compilación)"
  lane :reemplazar do
    viejo = ENV["OLD"].to_s
    nuevo = ENV["NEW"].to_s
    UI.user_error!("Faltan OLD y NEW") if viejo.empty? || nuevo.empty?
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], filepath: ENV["ASC_KEY_PATH"]
    )
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("No se encontró la app") unless app
    builds = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 30)
    b_old = builds.find { |b| b.version.to_s == viejo }
    b_new = builds.find { |b| b.version.to_s == nuevo }
    UI.user_error!("No se encontró la compilación #{nuevo}") unless b_new
    UI.user_error!("La compilación #{nuevo} aún no está procesada (#{b_new.processing_state})") unless b_new.processing_state == "VALID"

    if b_old
      begin
        Spaceship::ConnectAPI.patch_builds(build_id: b_old.id, attributes: { expired: true })
        UI.success("Compilación #{viejo} retirada (caducada): ya no está en revisión")
      rescue StandardError => ex
        UI.important("No se pudo retirar la #{viejo}: #{ex.message.to_s[0, 400]}")
      end
      sleep 8
    end

    app.get_beta_groups.select { |g| ["Testers Moon", "Pruebas"].include?(g.name) }.each do |g|
      begin
        b_new.add_beta_groups(beta_groups: [g])
        UI.success("Compilación #{nuevo} añadida a «#{g.name}»")
      rescue StandardError => ex
        UI.important("Al añadir a «#{g.name}»: #{ex.message.to_s[0, 300]}")
      end
    end

    3.times do |n|
      begin
        b_new.post_beta_app_review_submission
        UI.success("Compilación #{nuevo} enviada a revisión de Apple")
        break
      rescue StandardError => ex
        UI.important("Envío a revisión (intento #{n + 1}): #{ex.message.to_s[0, 400]}")
        sleep 10
      end
    end
  end
end
